    "@element-plus/nuxt": "1.1.5",
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "1.0.2",
    "dayjs": "1.11.23",
    "element-plus": "2.14.6",
    "lodash-unified": "^1.0.3",
    "nuxt": "4.5.2",
    "pinia": "4.0.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.2",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-themes": "10.6.0",
    "@storybook/vue3-vite": "10.6.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.11.0",
    "happy-dom": "20.14.5",
    "storybook": "10.6.0",
    "typescript": "5.9.3",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
